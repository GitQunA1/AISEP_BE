using AISEP.Data;
using AISEP.Models;
using AISEP.Repositories;
using Microsoft.EntityFrameworkCore;
using System.Linq.Expressions;

namespace AISEP.Repositories.Bookings
{
    public class BookingRepository : Repository<Models.Booking>, IBookingRepository
    {
        public BookingRepository(ApplicationDbContext context) : base(context)
        {
        }

        // Override GetByIdAsync để include navigation properties
        public override async Task<Models.Booking?> GetByIdAsync(Guid id)
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .Include(b => b.ChatSessions)
                .Include(b => b.ConsultingReports)
                .FirstOrDefaultAsync(b => b.Id == id);
        }

        // Override GetAllAsync để include basic navigation properties
        public override async Task<IEnumerable<Models.Booking>> GetAllAsync()
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .OrderByDescending(b => b.StartTime)
                .ToListAsync();
        }

        // Override FindAsync để include navigation properties
        public override async Task<IEnumerable<Models.Booking>> FindAsync(Expression<Func<Models.Booking, bool>> predicate)
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .Where(predicate)
                .OrderByDescending(b => b.StartTime)
                .ToListAsync();
        }

        // Custom methods
        public async Task<IEnumerable<Models.Booking>> GetBookingsByAdvisorIdAsync(Guid advisorId)
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .Where(b => b.AdvisorId == advisorId)
                .OrderByDescending(b => b.StartTime)
                .ToListAsync();
        }

        public async Task<IEnumerable<Models.Booking>> GetBookingsByCustomerIdAsync(Guid customerId)
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .Where(b => b.CustomerId == customerId)
                .OrderByDescending(b => b.StartTime)
                .ToListAsync();
        }

        public async Task<Models.Booking?> GetBookingWithDetailsAsync(Guid bookingId)
        {
            return await _dbSet
                .Include(b => b.Advisor)
                    .ThenInclude(a => a.User)
                .Include(b => b.Customer)
                .Include(b => b.ChatSessions)
                .Include(b => b.ConsultingReports)
                .FirstOrDefaultAsync(b => b.Id == bookingId);
        }
    }
}
