using AISEP.Data;
using AISEP.Models;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Storage;

namespace AISEP.Common
{
    public class UnitOfWork : IUnitOfWork
    {
        private readonly ApplicationDbContext _context;
        private IDbContextTransaction? _transaction;

        public UnitOfWork(ApplicationDbContext context)
        {
            _context = context;
        }

        // DbSets - Truy cập trực tiếp
        public DbSet<User> Users => _context.Users;
        public DbSet<RefreshToken> RefreshTokens => _context.RefreshTokens;
        public DbSet<Booking> Bookings => _context.Bookings;
        public DbSet<Advisor> Advisors => _context.Advisors;
        public DbSet<Startup> Startups => _context.Startups;
        public DbSet<Investor> Investors => _context.Investors;
        public DbSet<Project> Projects => _context.Projects;
        public DbSet<Deal> Deals => _context.Deals;
        public DbSet<Transaction> Transactions => _context.Transactions;
        public DbSet<Wallet> Wallets => _context.Wallets;
        public DbSet<WalletTransaction> WalletTransactions => _context.WalletTransactions;
        public DbSet<Notification> Notifications => _context.Notifications;
        public DbSet<ChatSession> ChatSessions => _context.ChatSessions;
        public DbSet<ChatMessage> ChatMessages => _context.ChatMessages;
        public DbSet<Review> Reviews => _context.Reviews;
        public DbSet<Subscription> Subscriptions => _context.Subscriptions;
        public DbSet<Package> Packages => _context.Packages;
        public DbSet<ActionLog> ActionLogs => _context.ActionLogs;
        public DbSet<Document> Documents => _context.Documents;
        public DbSet<ConnectionRequest> ConnectionRequests => _context.ConnectionRequests;
        public DbSet<ConsultingReport> ConsultingReports => _context.ConsultingReports;
        public DbSet<WithdrawRequest> WithdrawRequests => _context.WithdrawRequests;
        public DbSet<AIReport> AIReports => _context.AIReports;
        public DbSet<NFTRecord> NFTRecords => _context.NFTRecords;
        public DbSet<BlockchainProof> BlockchainProofs => _context.BlockchainProofs;
        public DbSet<SuccessStory> SuccessStories => _context.SuccessStories;

        // Save changes
        public async Task<int> SaveChangesAsync(CancellationToken cancellationToken = default)
        {
            return await _context.SaveChangesAsync(cancellationToken);
        }

        // Transaction management
        public async Task BeginTransactionAsync()
        {
            _transaction = await _context.Database.BeginTransactionAsync();
        }

        public async Task CommitTransactionAsync()
        {
            try
            {
                await _context.SaveChangesAsync();
                if (_transaction != null)
                {
                    await _transaction.CommitAsync();
                }
            }
            catch
            {
                await RollbackTransactionAsync();
                throw;
            }
            finally
            {
                if (_transaction != null)
                {
                    await _transaction.DisposeAsync();
                    _transaction = null;
                }
            }
        }

        public async Task RollbackTransactionAsync()
        {
            if (_transaction != null)
            {
                await _transaction.RollbackAsync();
                await _transaction.DisposeAsync();
                _transaction = null;
            }
        }

        // Dispose
        public void Dispose()
        {
            _transaction?.Dispose();
            _context.Dispose();
        }
    }
}
