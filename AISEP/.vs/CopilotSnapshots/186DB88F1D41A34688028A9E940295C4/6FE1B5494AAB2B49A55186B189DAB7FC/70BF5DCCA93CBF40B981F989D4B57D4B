using AISEP.DTOs;

namespace AISEP.Services
{
    /// <summary>
    /// Service để lấy thông tin user hiện tại từ HTTP context
    /// </summary>
    public interface ICurrentUserService
    {
        /// <summary>
        /// Lấy User ID của user đang đăng nhập
        /// </summary>
        /// <returns>User ID hoặc null nếu chưa đăng nhập</returns>
        Guid? GetUserId();

        /// <summary>
        /// Lấy Email của user đang đăng nhập
        /// </summary>
        /// <returns>Email hoặc null</returns>
        string? GetUserEmail();

        /// <summary>
        /// Lấy Username của user đang đăng nhập
        /// </summary>
        /// <returns>Username hoặc null</returns>
        string? GetUserName();

        /// <summary>
        /// Lấy Role của user đang đăng nhập
        /// </summary>
        /// <returns>Role hoặc null</returns>
        string? GetUserRole();

        /// <summary>
        /// Kiểm tra user đã đăng nhập chưa
        /// </summary>
        /// <returns>True nếu đã đăng nhập</returns>
        bool IsAuthenticated();

        /// <summary>
        /// Lấy toàn bộ thông tin user đang đăng nhập từ database
        /// </summary>
        /// <returns>UserResponseDto hoặc null nếu không tìm thấy</returns>
        Task<UserResponseDto?> GetCurrentUserAsync();
    }
}
