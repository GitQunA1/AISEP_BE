using AISEP.Data;
using AISEP.Models;
using AISEP.Repositories;

namespace AISEP.Common
{
  public class UnitOfWork : IUnitOfWork
  {
   private readonly ApplicationDbContext _context;

       
        private IRepository<User>? _users;
        private IRepository<Startup>? _startups;
        private IRepository<Investor>? _investors;
        private IRepository<Advisor>? _advisors;
        private IRepository<Project>? _projects;
        private IRepository<Document>? _documents;
        private IRepository<AIReport>? _aiReports;
        private IRepository<ConnectionRequest>? _connectionRequests;
        private IRepository<Deal>? _deals;
        private IRepository<NFTRecord>? _nftRecords;
        private IRepository<Booking>? _bookings;
        private IRepository<Wallet>? _wallets;
        private IRepository<Transaction>? _transactions;
        private IRepository<Subscription>? _subscriptions;
        private IRepository<ActionLog>? _actionLogs;
        private IRepository<SuccessStory>? _successStories;
        private IRepository<ChatSession>? _chatSessions;
        private IRepository<ChatMessage>? _chatMessages;
        private IRepository<ConsultingReport>? _consultingReports;
        private IRepository<Review>? _reviews;
        private IRepository<Package>? _packages;
        private IRepository<WalletTransaction>? _walletTransactions;
        private IRepository<WithdrawRequest>? _withdrawRequests;
        private IRepository<Notification>? _notifications;
        private IRepository<BlockchainProof>? _blockchainProofs;
        private IRepository<RefreshToken>? _refreshTokens;

        public UnitOfWork(ApplicationDbContext context)
        {
            _context = context;
        }

        
        public IRepository<User> Users => _users ??= new Repository<User>(_context);
        public IRepository<Startup> Startups => _startups ??= new Repository<Startup>(_context);
        public IRepository<Investor> Investors => _investors ??= new Repository<Investor>(_context);
        public IRepository<Advisor> Advisors => _advisors ??= new Repository<Advisor>(_context);
        public IRepository<Project> Projects => _projects ??= new Repository<Project>(_context);
        public IRepository<Document> Documents => _documents ??= new Repository<Document>(_context);
        public IRepository<AIReport> AIReports => _aiReports ??= new Repository<AIReport>(_context);
        public IRepository<ConnectionRequest> ConnectionRequests => _connectionRequests ??= new Repository<ConnectionRequest>(_context);
        public IRepository<Deal> Deals => _deals ??= new Repository<Deal>(_context);
        public IRepository<NFTRecord> NFTRecords => _nftRecords ??= new Repository<NFTRecord>(_context);
        public IRepository<Booking> Bookings => _bookings ??= new Repository<Booking>(_context);
        public IRepository<Wallet> Wallets => _wallets ??= new Repository<Wallet>(_context);
        public IRepository<Transaction> Transactions => _transactions ??= new Repository<Transaction>(_context);
        public IRepository<Subscription> Subscriptions => _subscriptions ??= new Repository<Subscription>(_context);
        public IRepository<ActionLog> ActionLogs => _actionLogs ??= new Repository<ActionLog>(_context);
        public IRepository<SuccessStory> SuccessStories => _successStories ??= new Repository<SuccessStory>(_context);
        public IRepository<ChatSession> ChatSessions => _chatSessions ??= new Repository<ChatSession>(_context);
        public IRepository<ChatMessage> ChatMessages => _chatMessages ??= new Repository<ChatMessage>(_context);
        public IRepository<ConsultingReport> ConsultingReports => _consultingReports ??= new Repository<ConsultingReport>(_context);
        public IRepository<Review> Reviews => _reviews ??= new Repository<Review>(_context);
        public IRepository<Package> Packages => _packages ??= new Repository<Package>(_context);
        public IRepository<WalletTransaction> WalletTransactions => _walletTransactions ??= new Repository<WalletTransaction>(_context);
        public IRepository<WithdrawRequest> WithdrawRequests => _withdrawRequests ??= new Repository<WithdrawRequest>(_context);
        public IRepository<Notification> Notifications => _notifications ??= new Repository<Notification>(_context);
        public IRepository<BlockchainProof> BlockchainProofs => _blockchainProofs ??= new Repository<BlockchainProof>(_context);
        public IRepository<RefreshToken> RefreshTokens => _refreshTokens ??= new Repository<RefreshToken>(_context);

        public async Task<int> SaveChangesAsync()
        {
            return await _context.SaveChangesAsync();
        }

        public void Dispose()
        {
            _context.Dispose();
        }
  }
}
