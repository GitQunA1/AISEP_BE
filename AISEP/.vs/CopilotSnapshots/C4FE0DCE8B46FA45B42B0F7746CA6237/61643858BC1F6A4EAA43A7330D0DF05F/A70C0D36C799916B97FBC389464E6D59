using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace AISEP.Models
{
    [Table("deals")]
    public class Deal
  {
  [Key]
        [Column("id")]
public Guid Id { get; set; }

 [Column("investor_id")]
        public Guid InvestorId { get; set; }

  [Column("project_id")]
        public Guid ProjectId { get; set; }

        [Column("amount", TypeName = "decimal(18,2)")]
      public decimal Amount { get; set; }

   [Column("startup_confirmed")]
     public bool StartupConfirmed { get; set; }

 [Column("investor_confirmed")]
        public bool InvestorConfirmed { get; set; }

[Column("status")]
    [MaxLength(50)]
 public string Status { get; set; } = string.Empty;

  [Column("deal_date")]
      public DateTime DealDate { get; set; }

 [Column("payment_method")]
        [MaxLength(50)]
   public string? PaymentMethod { get; set; }

 [Column("equity_percentage", TypeName = "decimal(5,2)")]
        public decimal? EquityPercentage { get; set; }

[Column("transaction_hash")]
    [MaxLength(255)]
   public string? TransactionHash { get; set; }

        [Column("is_completed")]
  public bool IsCompleted { get; set; }

        [Column("completion_date")]
 public DateTime? CompletionDate { get; set; }

        // Navigation properties
   [ForeignKey("InvestorId")]
        public Investor Investor { get; set; } = null!;

        [ForeignKey("ProjectId")]
        public Project Project { get; set; } = null!;

        public ICollection<NFTRecord> NFTRecords { get; set; } = new List<NFTRecord>();
    }
}
