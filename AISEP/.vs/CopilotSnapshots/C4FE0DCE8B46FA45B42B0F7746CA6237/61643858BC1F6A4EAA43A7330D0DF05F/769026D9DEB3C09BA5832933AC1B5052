using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace AISEP.Models
{
    [Table("documents")]
    public class Document
    {
        [Key]
        [Column("id")]
     public Guid Id { get; set; }

      [Column("project_id")]
        public Guid ProjectId { get; set; }

      [Column("document_type")]
        [MaxLength(50)]
  public string DocumentType { get; set; } = string.Empty; // PitchDeck, BusinessPlan, Other

        [Column("file_name")]
     [MaxLength(255)]
   public string FileName { get; set; } = string.Empty;

     [Column("file_url")]
    [MaxLength(255)]
        public string FileUrl { get; set; } = string.Empty;

        [Column("file_hash")]
    [MaxLength(255)]
        public string? FileHash { get; set; }

        [Column("blockchain_tx_hash")]
 [MaxLength(255)]
  public string? BlockchainTxHash { get; set; }

        [Column("is_ip_protected")]
        public bool IsIpProtected { get; set; }

 [Column("verified_at")]
        public DateTime? VerifiedAt { get; set; }

 // Navigation properties
     [ForeignKey("ProjectId")]
        public Project Project { get; set; } = null!;

        public ICollection<BlockchainProof> BlockchainProofs { get; set; } = new List<BlockchainProof>();
    }
}
