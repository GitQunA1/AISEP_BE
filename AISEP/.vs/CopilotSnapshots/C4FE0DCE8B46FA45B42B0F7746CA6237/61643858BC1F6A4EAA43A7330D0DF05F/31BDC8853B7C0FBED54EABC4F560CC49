using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace AISEP.Models
{
    [Table("nftrecords")]
    public class NFTRecord
    {
        [Key]
        public Guid Id { get; set; }

      public Guid DealId { get; set; }

        [MaxLength(255)]
        public string TokenId { get; set; } = string.Empty;

        [MaxLength(255)]
        public string TxHash { get; set; } = string.Empty;

[MaxLength(255)]
        public string OwnerWallet { get; set; } = string.Empty;

        public DateTime MintedAt { get; set; }

        [MaxLength(50)]
        public string ValidityStatus { get; set; } = string.Empty; // Valid, Invalid, Expired

        public bool Transferable { get; set; }

        [MaxLength(255)]
        public string? PreviousOwnerWallet { get; set; }

        // Navigation properties
        [ForeignKey("DealId")]
        public Deal Deal { get; set; } = null!;
    }
}
